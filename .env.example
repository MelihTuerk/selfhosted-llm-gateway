# Copy to .env and adjust:  cp .env.example .env

# llama.cpp server image (pin a build tag for reproducibility)
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Model file inside ./models (download with scripts/download-model.sh)
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
# Model name reported by /v1/models
MODEL_ALIAS=qwen2.5-0.5b-instruct

# Total context size in tokens, shared by all parallel slots
CTX_SIZE=4096
# Number of requests processed in parallel
PARALLEL=2

# Host port for direct access to llama.cpp (bound to 127.0.0.1)
LLM_PORT=8080
