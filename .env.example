# Copy to .env and adjust:  cp .env.example .env

# llama.cpp server images (pin a build tag for reproducibility)
# "cpu" profile:
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# "gpu" profile (CUDA, needs the NVIDIA Container Toolkit):
LLAMA_GPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# Layers offloaded to the GPU ("gpu" profile only); 99 = all. Lower it if VRAM runs out.
GPU_LAYERS=99

# Model file inside ./models (download with scripts/download-model.sh).
# For split models (name-00001-of-0000N.gguf) give the first part.
# Example for a 6 GB GPU:  scripts/download-model.sh qwen2.5-7b-q4
#   MODEL_FILE=qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
#   MODEL_ALIAS=qwen2.5-7b-instruct
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
# Model name reported by /v1/models
MODEL_ALIAS=qwen2.5-0.5b-instruct

# Total context size in tokens, shared by all parallel slots
CTX_SIZE=4096
# Number of requests processed in parallel
PARALLEL=2

# API keys accepted by the gateway, comma-separated. Generate one with:
#   openssl rand -hex 32
GATEWAY_API_KEYS=replace-with-a-random-key
# Rate limit per API key: sustained requests per minute, plus a burst allowance.
# Set either to 0 to disable rate limiting.
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_RATE_LIMIT_BURST=10
# Host port of the gateway (bound to 127.0.0.1)
GATEWAY_PORT=8000

# Host port for direct access to llama.cpp, only with compose.dev.yaml
LLM_PORT=8080

# --- Monitoring ---------------------------------------------------------------
# Grafana login: user "admin" and this password. Generate one with:
#   openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
# Host ports (bound to 127.0.0.1)
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
# How long Prometheus keeps data
PROMETHEUS_RETENTION=7d
