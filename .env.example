# Copy to .env and adjust:  cp .env.example .env

# llama.cpp server image (pin a build tag for reproducibility)
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Model file inside ./models (download with scripts/download-model.sh)
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
# Model name reported by /v1/models
MODEL_ALIAS=qwen2.5-0.5b-instruct

# Total context size in tokens, shared by all parallel slots
CTX_SIZE=4096
# Number of requests processed in parallel
PARALLEL=2

# API keys accepted by the gateway, comma-separated. Generate one with:
#   openssl rand -hex 32
GATEWAY_API_KEYS=replace-with-a-random-key
# Rate limit per API key: sustained requests per minute, plus a burst allowance.
# Set either to 0 to disable rate limiting.
GATEWAY_RATE_LIMIT_PER_MINUTE=60
GATEWAY_RATE_LIMIT_BURST=10
# Host port of the gateway (bound to 127.0.0.1)
GATEWAY_PORT=8000

# Host port for direct access to llama.cpp, only with compose.dev.yaml
LLM_PORT=8080
